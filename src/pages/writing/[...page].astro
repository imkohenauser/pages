---
import type { GetStaticPaths } from 'astro';
import List from '../../components/List.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { writingListItem } from '../../lib/list';
import { getWriting, type Writing } from '../../lib/writing';
import { path } from '../../lib/path';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getWriting(), { pageSize: 10 })) satisfies GetStaticPaths;

interface Props {
  page: {
    data: Writing[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { page } = Astro.props;
const paged = page.currentPage > 1;
const title = paged ? `Writing (page ${page.currentPage})` : 'Writing';
const description = paged
  ? `Writing by ${site.name}, page ${page.currentPage}.`
  : `Writing by ${site.name}.`;
---

<Base title={title} description={description}>
  <section class="writing-section" aria-labelledby="writing-title">
    <h1 class="writing-title" id="writing-title">Writing</h1>
    <List
      variant="writing"
      headingLevel={2}
      items={page.data.map(writingListItem)}
    />
    {page.lastPage > 1 && (
      <nav aria-label="Pagination">
        <span>{page.url.prev && <a href={path(page.url.prev)}>← Prev</a>}</span>
        <span>{page.currentPage} / {page.lastPage}</span>
        <span>{page.url.next && <a href={path(page.url.next)}>Next →</a>}</span>
      </nav>
    )}
  </section>
</Base>


<style lang="scss">
  @use "tools" as *;

  .writing-section {
    padding: 0 var(--space-2) var(--space-2);
  }

  .writing-title {
    margin: 0;
    padding: var(--space-4) var(--space-4) 0;
    font-size: var(--text-2xl);
    line-height: rem(32);
    letter-spacing: -0.015em;
    overflow-wrap: break-word;
    text-wrap: balance;

    @include md {
      padding-bottom: var(--space-2);
      font-size: var(--text-3xl);
      line-height: rem(40);
    }
  }
</style>