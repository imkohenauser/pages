---
import type { GetStaticPaths } from 'astro';
import List from '../../components/List.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { postListItem } from '../../lib/list';
import { getPosts, type Post } from '../../lib/posts';
import { path } from '../../lib/path';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getPosts(), { pageSize: 10 })) satisfies GetStaticPaths;

interface Props {
  page: {
    data: Post[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { page } = Astro.props;
const paged = page.currentPage > 1;
const title = paged ? `Writing (page ${page.currentPage})` : 'Writing';
const description = paged
  ? `Writing by ${site.name}, page ${page.currentPage}.`
  : `Writing by ${site.name}.`;
---

<Base title={title} description={description}>
  <main>
    <h1>Writing</h1>
    <List class="writing" items={page.data.map(postListItem)} />
    {page.lastPage > 1 && (
      <nav aria-label="Pagination">
        <span>{page.url.prev && <a href={path(page.url.prev)}>← Prev</a>}</span>
        <span>{page.currentPage} / {page.lastPage}</span>
        <span>{page.url.next && <a href={path(page.url.next)}>Next →</a>}</span>
      </nav>
    )}
  </main>
</Base>
