---
import List from '../../components/List.astro';
import WritingFilter from '../../components/WritingFilter.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { writingListItem } from '../../lib/list';
import { getWriting } from '../../lib/writing';
import { writingLabelCounts } from '../../lib/writing-label';

const writing = await getWriting();
const items = writing.map(writingListItem);
const labelOptions = writingLabelCounts(writing);
const title = 'Writing';
const description = `Writing by ${site.name}.`;
---

<Base title={title} description={description}>
  <section class="writing-section" aria-labelledby="writing-title">
    <h1 class="writing-title font-display" id="writing-title">Writing</h1>
    <writing-filter>
      <WritingFilter options={labelOptions} />
      <List variant="writing" headingLevel={2} items={items} />
      <div class="writing-empty" data-writing-filter-empty hidden>
        <p class="writing-empty__message">
          No writing matches the current filters.
        </p>
      </div>
    </writing-filter>
  </section>
</Base>

<style lang="scss">
  @use "tools" as *;

  .writing-section {
    padding: 0 var(--space-2) var(--space-2);
  }

  .writing-title {
    margin: 0;
    padding: var(--space-4) var(--space-4) 0;
    font-size: var(--text-2xl);
    line-height: rem(32);
    /* -0.36px at 24px and -0.48px at 32px. */
    letter-spacing: rem(-0.36);
    color: var(--color-text);
    overflow-wrap: break-word;
    text-wrap: balance;

    @include md {
      font-size: var(--text-3xl);
      line-height: rem(40);
      letter-spacing: rem(-0.48);
    }
  }

  .writing-empty {
    padding-inline: var(--space-4);
    padding-bottom: var(--space-10);
  }

  .writing-empty__message {
    margin: 0;
  }
</style>

<script>
  import { defineWritingFilter } from '../../lib/writing-filter';

  defineWritingFilter();
</script>
