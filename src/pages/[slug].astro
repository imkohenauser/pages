---
import type { GetStaticPaths } from 'astro';
import WritingLayout from '../layouts/WritingLayout.astro';
import { getWriting, type Writing } from '../lib/writing';

export const getStaticPaths = (async () => {
  const writing = (await getWriting()).filter((entry) => !entry.data.externalUrl);
  return writing.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      writing: entry,
      older: writing[index + 1],
      newer: writing[index - 1],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  writing: Writing;
  older?: Writing;
  newer?: Writing;
}

const { writing, older, newer } = Astro.props;
---

<WritingLayout writing={writing} older={older} newer={newer} />
