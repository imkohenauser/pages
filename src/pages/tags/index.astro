---
import TagBadge from '@/components/TagBadge.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTags } from '@/lib/posts';

const tags = await getTags();
---

<BaseLayout title="Tags" description="タグ別のアーカイブ一覧。">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="text-2xl font-bold tracking-tight" data-anim="fade-up">Tags</h1>

    {
      tags.length === 0 ? (
        <p class="text-muted-foreground mt-6 text-sm">まだタグがありません。</p>
      ) : (
        <div
          class="mt-6 flex flex-wrap gap-2"
          data-anim="fade-up"
          data-anim-children="a"
          data-anim-stagger="0.03"
        >
          {tags.map((tag) => (
            <TagBadge tag={tag.tag} count={tag.count} class="h-7 px-3 text-sm" />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
