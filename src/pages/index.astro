---
import Base from '../layouts/Base.astro';
import BinaryBackground from '../components/home/BinaryBackground.astro';
import Hero from '../components/home/Hero.astro';
import JsonLd from '../components/JsonLd.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import WritingSection from '../components/home/WritingSection.astro';
import { getWriting } from '../lib/writing';
import { getProjects } from '../lib/projects';
import { site } from '../data/site';
import { homeJsonLd } from '../lib/seo';

const writing = await getWriting();
const projects = await getProjects();
---

<Base description={site.bio}>
  <JsonLd slot="head" data={homeJsonLd()} />
  <BinaryBackground>
    <Hero title={site.title} description={site.bio} />
  </BinaryBackground>
  <div class="section-container">
    <WritingSection writing={writing} />
    <ProjectsSection projects={projects} />
  </div>
</Base>

<style lang="scss">
  @use "tools" as *;

  :global(html) {
    overflow-x: clip;
  }

  .section-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);

    @include md {
      gap: 0;
      padding-top: var(--space-8);
    }
  }
</style>
