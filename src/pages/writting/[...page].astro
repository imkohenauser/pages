---
import type { GetStaticPaths } from 'astro';
import { getPosts, type Post } from '../../lib/posts';
import { path } from '../../lib/path';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getPosts(), { pageSize: 10 })) satisfies GetStaticPaths;

interface Props {
  page: {
    data: Post[];
    currentPage: number;
  };
}

const { page } = Astro.props;
const destination = page.currentPage === 1
  ? path('/writing/')
  : path(`/writing/${page.currentPage}/`);

if (!destination.startsWith('/')) {
  throw new Error(`Expected an absolute redirect path, received: ${destination}`);
}

return Astro.redirect(destination, 301);
---
