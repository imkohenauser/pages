---
import { ArrowLeft } from 'lucide-react';
import FeaturedImage from '@/components/FeaturedImage.astro';
import TagBadge from '@/components/TagBadge.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import { formatDate, isoDate, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, featuredImage } = post.data;

/**
 * Reuse the featured image as the social card instead of rendering one per post
 * with satori. A hand-picked image beats generated text, and for posts without
 * one the site-wide default is a fair fallback. For local images `.src` is the
 * hashed build output, which is already absolute-ready.
 */
const socialImage = typeof featuredImage === 'string' ? featuredImage : featuredImage?.src;
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="flex flex-col gap-4" data-anim="fade-up">
      <div class="text-muted-foreground flex flex-wrap items-center gap-2 text-xs">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {
          updated && (
            <>
              <span aria-hidden="true">/</span>
              <span>
                更新 <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
      </div>

      <h1 class="text-2xl leading-tight font-bold tracking-tight text-balance sm:text-3xl">
        {title}
      </h1>

      {description && <p class="text-muted-foreground text-base">{description}</p>}

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <TagBadge tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    {
      featuredImage && (
        <div class="bg-muted mt-8 overflow-hidden rounded-xl" data-anim="scale-in">
          <FeaturedImage
            src={featuredImage}
            alt=""
            loading="eager"
            sizes="(min-width: 768px) 768px, 100vw"
            widths={[640, 768, 1536]}
            class="aspect-16/9 w-full object-cover"
          />
        </div>
      )
    }

    <div
      class="prose prose-neutral dark:prose-invert prose-headings:tracking-tight prose-pre:border prose-pre:border-border/60 prose-img:rounded-lg mt-10 max-w-none"
      data-anim="fade"
      data-anim-start="top 95%"
    >
      <slot />
    </div>

    <footer class="border-border/60 mt-16 border-t pt-6">
      <a
        href={withBase('/')}
        class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm transition-colors"
      >
        <ArrowLeft className="size-4" aria-hidden="true" />
        アーカイブに戻る
      </a>
    </footer>
  </article>
</BaseLayout>
