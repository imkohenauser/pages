---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ArticleActions from '../components/ArticleActions.astro';
import JsonLd from '../components/JsonLd.astro';
import WritingProse from '../components/WritingProse.astro';
import { path } from '../lib/path';
import { readingMinutes } from '../lib/reading-time';
import { writingHref, type Writing } from '../lib/writing';
import {
  absoluteUrl,
  writingBreadcrumbJsonLd,
  writingJsonLd,
  writingCanonicalUrl,
  writingImageAlt,
  writingImageDimensions,
  writingImageUrl,
  writingModifiedAt,
} from '../lib/seo';
import Base from './Base.astro';

interface Props {
  writing: Writing;
  older?: Writing;
  newer?: Writing;
}

const { writing, older, newer } = Astro.props;
const { Content, headings } = await render(writing);
const locale = writing.data.lang === 'ja' ? 'ja-JP' : writing.data.lang;
const format = new Intl.DateTimeFormat(locale);
const modifiedAt = writingModifiedAt(writing);
const showModified = modifiedAt.valueOf() !== writing.data.publishedAt.valueOf();
const body = writing.body ?? '';
const minutes = readingMinutes(body, writing.data.lang);
const canonicalUrl = writingCanonicalUrl(writing);
const imageDimensions = writingImageDimensions(writing);
const markdown = `# ${writing.data.title}\n\n${writing.data.description}\n\n${body}`;
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const hasWritingNavigation = Boolean(older || newer);
---

<Base
  title={writing.data.title}
  description={writing.data.description}
  canonicalUrl={canonicalUrl}
  noindex={writing.data.noindex}
  type="article"
  image={writingImageUrl(writing)}
  imageAlt={writingImageAlt(writing)}
  imageWidth={imageDimensions.width}
  imageHeight={imageDimensions.height}
  authorUrl={absoluteUrl('/')}
  publishedTime={writing.data.publishedAt}
  modifiedTime={modifiedAt}
  lang={writing.data.lang}
>
  <JsonLd slot="head" data={writingJsonLd(writing)} />
  <JsonLd slot="head" data={writingBreadcrumbJsonLd(writing)} />
  <article class="writing-article">
    <header class="writing-article__header">
      <h1>{writing.data.title}</h1>
      <p class="writing-article__description">{writing.data.description}</p>
      <p class="writing-article__meta">
        <time datetime={writing.data.publishedAt.toISOString()}>
          {format.format(writing.data.publishedAt)}
        </time>
        {showModified && (
          <>
            {' '}
            <span>
              (updated{' '}
              <time datetime={modifiedAt.toISOString()}>
                {format.format(modifiedAt)}
              </time>)
            </span>
          </>
        )}
        <span aria-hidden="true"> · </span>
        <span>{minutes} min read</span>
      </p>
      <ArticleActions markdown={markdown} url={canonicalUrl} />
    </header>

    {writing.data.featuredImage && (
      <Image
        src={writing.data.featuredImage}
        alt={writing.data.featuredImageAlt ?? ''}
      />
    )}

    {tableOfContents.length > 0 && (
      <nav class="writing-toc" aria-label="Table of contents">
        <p class="writing-toc__label">On this page</p>
        <ol class="writing-toc__list">
          {tableOfContents.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="writing-article__content">
      <WritingProse>
        <Content />
      </WritingProse>
    </div>
  </article>

  {hasWritingNavigation && (
    <nav class="writing-navigation" aria-label="Writing">
      <span>{older && <a href={path(writingHref(older))}>← {older.data.title}</a>}</span>
      <span>{newer && <a href={path(writingHref(newer))}>{newer.data.title} →</a>}</span>
    </nav>
  )}
</Base>

<style lang="scss">
  @use "tools" as *;

  .writing-article {
    padding: var(--space-4) var(--space-3) var(--space-20);

    h1 {
      max-width: rem(680);
      margin: 0 0 var(--space-4);
      font-family: var(--font-sans);
      font-size: var(--text-3xl);
      line-height: rem(40);
      text-wrap: balance;
    }
  }

  .writing-article__header,
  .writing-toc,
  .writing-article__content,
  .writing-navigation {
    padding: 0 var(--space-3);
  }

  .writing-article__header {
    margin-block-end: var(--space-10);

    :global(.article-actions) {
      margin-block-start: var(--space-5);
    }
  }

  .writing-article__description {
    max-width: rem(640);
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
    line-height: rem(28);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .writing-article__meta {
    margin: 0;
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text-muted);
  }

  .writing-toc {
    margin-block: 0 var(--space-12);
  }

  .writing-toc__label {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: rem(20);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .writing-toc__list {
    display: grid;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: var(--space-4) 0 0;
    font-size: var(--text-sm);
    line-height: rem(20);
    list-style: none;
    border-block-start: rem(1) solid var(--color-border-strong);

    @include md {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    a {
      color: var(--color-text-muted);
      font-weight: 500;
      text-decoration: none;
      border-radius: rem(2);

      @include hover-color-transition;

      @include hover {
        &:hover {
          color: var(--color-link);
        }
      }

      &:focus-visible {
        color: var(--color-link);
        outline: rem(3) solid var(--color-focus);
        outline-offset: rem(2);
      }
    }
  }

  .writing-navigation {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    margin-block-start: var(--space-16);
    font-size: var(--text-sm);
    line-height: rem(20);

    span:last-child {
      margin-inline-start: auto;
      text-align: end;
    }

    a {
      color: var(--color-link);
      text-underline-offset: rem(3);
      border-radius: rem(2);

      &:focus-visible {
        outline: rem(3) solid var(--color-focus);
        outline-offset: rem(2);
      }
    }
  }
</style>
