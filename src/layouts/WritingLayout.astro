---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import JsonLd from '../components/JsonLd.astro';
import { path } from '../lib/path';
import { writingHref, type Writing } from '../lib/writing';
import {
  writingJsonLd,
  writingCanonicalUrl,
  writingImageAlt,
  writingImageUrl,
  writingModifiedAt,
} from '../lib/seo';
import Base from './Base.astro';

interface Props {
  writing: Writing;
  older?: Writing;
  newer?: Writing;
}

const { writing, older, newer } = Astro.props;
const { Content } = await render(writing);
const locale = writing.data.lang === 'ja' ? 'ja-JP' : writing.data.lang;
const format = new Intl.DateTimeFormat(locale);
const modifiedAt = writingModifiedAt(writing);
const showModified = modifiedAt.valueOf() !== writing.data.publishedAt.valueOf();
---

<Base
  title={writing.data.title}
  description={writing.data.description}
  canonicalUrl={writingCanonicalUrl(writing)}
  noindex={writing.data.noindex}
  type="article"
  image={writingImageUrl(writing)}
  imageAlt={writingImageAlt(writing)}
  publishedTime={writing.data.publishedAt}
  modifiedTime={modifiedAt}
  lang={writing.data.lang}
>
  <JsonLd slot="head" data={writingJsonLd(writing)} />
  <article>
    <header>
      <h1>{writing.data.title}</h1>
      <p>{writing.data.description}</p>
      <p>
        <time datetime={writing.data.publishedAt.toISOString()}>
          {format.format(writing.data.publishedAt)}
        </time>
        {showModified && (
          <>
            {' '}
            <span>
              (updated{' '}
              <time datetime={modifiedAt.toISOString()}>
                {format.format(modifiedAt)}
              </time>)
            </span>
          </>
        )}
      </p>
    </header>

    {writing.data.featuredImage && (
      <Image
        src={writing.data.featuredImage}
        alt={writing.data.featuredImageAlt ?? ''}
      />
    )}

    <div>
      <Content />
    </div>
  </article>

  <nav aria-label="Writing">
    <span>{older && <a href={path(writingHref(older))}>← {older.data.title}</a>}</span>
    <span>{newer && <a href={path(writingHref(newer))}>{newer.data.title} →</a>}</span>
  </nav>
</Base>
