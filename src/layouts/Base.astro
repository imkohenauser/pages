---
import { Font } from 'astro:assets';
import '../styles.scss';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string | null;
  noindex?: boolean;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  lang?: string;
}

const {
  title,
  description = site.bio,
  canonicalUrl = Astro.url.href,
  noindex = false,
  type = 'website',
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  lang = site.lang,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonicalUrl ?? undefined}
      noindex={noindex}
      type={type}
      image={image}
      imageAlt={imageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      lang={lang}
    />
    <Font cssVariable="--font-line-seed-jp" />
    <Font cssVariable="--font-michroma" />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-container">
      <Header />
      <div class="site-main">
        <main id="main-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>

<style lang="scss">
  @use "tools" as *;

  .site-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;

    @include md {
      flex-direction: row;
      gap: var(--space-4);
      max-width: rem(1024);
      margin: 0 auto;
      padding: 0 var(--space-5);
    }
  }

  .site-main {
    flex: 1;
    min-width: 0;
    /* Matches the absolutely positioned header height on small screens. */
    padding-top: rem(64);

    @include md {
      padding-top: 0;
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }
  }
</style>