---
import { Font } from 'astro:assets';
import '../styles.scss';
import ActionLink from '../components/ActionLink.astro';
import BinaryBackground from '../components/BinaryBackground.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import SiteLoader from '../components/SiteLoader.astro';
import { site } from '../data/site';
import {
  SITE_LOADER_GLYPH_FILES,
  SITE_LOADER_SESSION_KEY,
} from '../lib/site-loader-data';
import { path } from '../lib/path';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string | null;
  noindex?: boolean;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  authorUrl?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  lang?: string;
}

const {
  title,
  description = site.bio,
  canonicalUrl = Astro.url.href,
  noindex = false,
  type = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  authorUrl,
  publishedTime,
  modifiedTime,
  lang = site.lang,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Analytics />
    <Seo
      title={title}
      description={description}
      canonical={canonicalUrl ?? undefined}
      noindex={noindex}
      type={type}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      authorUrl={authorUrl}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      lang={lang}
    />
    <Font cssVariable="--font-line-seed-jp" />
    <Font cssVariable="--font-michroma" />
    {
      SITE_LOADER_GLYPH_FILES.map((file) => (
        <link
          rel="preload"
          as="image"
          href={path(`/glyph/${file}`)}
          type="image/svg+xml"
        />
      ))
    }
    <script is:inline define:vars={{ sessionKey: SITE_LOADER_SESSION_KEY }}>
      try {
        if (sessionStorage.getItem(sessionKey)) {
          document.documentElement.dataset.siteLoader = 'skip';
        } else {
          document.documentElement.dataset.siteLoader = 'active';
        }
      } catch (_) {
        document.documentElement.dataset.siteLoader = 'active';
      }
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <SiteLoader />
    <a class="skip-link" href="#main-content" aria-label="Skip to content">
      <ActionLink variant="skip-to-content" decorative />
    </a>
    <div class="site-container">
      <Header />
      <div class="site-main">
        <BinaryBackground>
          <main id="main-content" tabindex="-1">
            <slot />
          </main>
        </BinaryBackground>
        {title && <Breadcrumbs currentPage={title} />}
        <Footer />
      </div>
    </div>
  </body>
</html>

<style lang="scss">
  @use "tools" as *;

  .skip-link {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-2);

    &:focus-visible {
      --action-link-label: var(--color-link);
      --action-link-icon: var(--sky-600);

      outline: rem(3) solid var(--color-focus);
      outline-offset: rem(2);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  .site-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;

    @include ml {
      flex-direction: row;
      gap: var(--space-4);
      max-width: rem(1024);
      margin: 0 auto;
      padding: 0 var(--space-5);
    }
  }

  .site-main {
    flex: 1;
    min-width: 0;
    padding-top: var(--space-16);

    @include ml {
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }
  }

  #main-content[data-page-top-focus]:focus {
    outline: none;
  }
</style>
