---
import BaseHead from '@/components/BaseHead.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import { SITE } from '@/consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}
---

<!doctype html>
<html lang={SITE.lang} class="scroll-pt-20">
  <head>
    <BaseHead {...Astro.props} />
    <ThemeScript />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="focus:bg-background focus:ring-ring sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:px-3 focus:py-2 focus:text-sm focus:ring-2"
    >
      本文へスキップ
    </a>

    <SiteHeader />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter />

    <script>
      /*
       * GSAP core plus ScrollTrigger is ~110 kB, so it is a dynamic import gated
       * on the page actually declaring something to animate. A page with no
       * `data-anim` or `data-parallax` never requests the chunk.
       */
      const hasMotion = () => document.querySelector('[data-anim], [data-parallax]') !== null;

      const load = async () => {
        if (!hasMotion()) return;
        const { initMotion, teardownMotion } = await import('@/lib/motion');
        initMotion();

        /*
         * No-ops unless <ClientRouter /> is enabled. Registering them anyway
         * means turning on view transitions later does not leave ScrollTriggers
         * bound to elements that have already been swapped out.
         */
        document.addEventListener('astro:page-load', () => initMotion());
        document.addEventListener('astro:before-swap', () => teardownMotion());
      };

      void load();
    </script>
  </body>
</html>
