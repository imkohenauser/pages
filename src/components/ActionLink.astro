---
import type { ActionLinkVariant } from '../lib/action-link';
import { path } from '../lib/path';
import Icon from './Icon.astro';

interface Props {
  variant: ActionLinkVariant;
  label?: string;
  iconSrc?: string;
  decorative?: boolean;
  tone?: 'default' | 'inverse';
}

const {
  variant,
  label,
  iconSrc,
  decorative = false,
  tone = 'default',
} = Astro.props;

const mediumLogo = path('/logo/medium.svg');
const zennLogo = path('/logo/zenn.svg');
---

<span
  class:list={['action-link', tone === 'inverse' && 'action-link--inverse']}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    variant === 'read' && (
      <>
        <span class="action-link__label">{label ?? 'Read article'}</span>
        <span class="action-link__icon">
          <Icon name="arrow-right" />
        </span>
      </>
    )
  }
  {
    variant === 'medium' && (
      <>
        <span
          class="action-link__logo"
          style={`--action-link-logo: url("${mediumLogo}")`}
        />
        <span class="action-link__icon">
          <Icon name="arrow-top-right" />
        </span>
      </>
    )
  }
  {
    variant === 'zenn' && (
      <>
        <span
          class="action-link__logo"
          style={`--action-link-logo: url("${zennLogo}")`}
        />
        <span class="action-link__icon">
          <Icon name="arrow-top-right" />
        </span>
      </>
    )
  }
  {
    variant === 'github' && (
      <>
        <span class="action-link__icon">
          <Icon name="github" />
        </span>
        <span class="action-link__label" translate="no">GitHub</span>
        <span class="action-link__icon">
          <Icon name="arrow-top-right" />
        </span>
      </>
    )
  }
  {
    variant === 'official-site' && iconSrc && (
      <>
        <img
          class="action-link__mark"
          src={iconSrc}
          alt=""
          width="16"
          height="16"
        />
        <span class="action-link__label">Official site</span>
        <span class="action-link__icon">
          <Icon name="arrow-top-right" />
        </span>
      </>
    )
  }
  {
    variant === 'page-top' && (
      <>
        <span class="action-link__label">Page top</span>
        <span class="action-link__icon">
          <Icon name="arrow-top" />
        </span>
      </>
    )
  }
  {
    variant === 'skip-to-content' && (
      <>
        <span class="action-link__label">Skip to content</span>
        <span class="action-link__icon">
          <Icon name="arrow-right" />
        </span>
      </>
    )
  }
</span>

<style lang="scss">
  @use "tools" as *;

  .action-link {
    --action-link-label-default: var(--color-text);
    --action-link-icon-default: var(--color-text-muted);

    display: inline-flex;
    align-items: center;
    gap: var(--space-1\.5);
    padding: var(--space-1) var(--space-1\.5);
    border-radius: var(--radius-1\.5);
  }

  .action-link--inverse {
    --action-link-label-default: var(--color-text-inverse);
    --action-link-icon-default: var(--color-text-inverse-muted);
  }

  .action-link__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--action-link-label, var(--action-link-label-default));
    white-space: nowrap;
  }

  .action-link__icon {
    display: grid;
    flex-shrink: 0;
    width: rem(16);
    height: rem(16);
    color: var(--action-link-icon, var(--action-link-icon-default));
  }

  .action-link__logo {
    flex-shrink: 0;
    width: rem(64);
    height: rem(14);
    color: var(--action-link-label, var(--action-link-label-default));
    background-color: currentColor;
    -webkit-mask: var(--action-link-logo) left center / contain no-repeat;
    mask: var(--action-link-logo) left center / contain no-repeat;
  }

  .action-link__mark {
    flex-shrink: 0;
    width: rem(16);
    height: rem(16);
    border-radius: rem(3);
    object-fit: cover;
  }
</style>
