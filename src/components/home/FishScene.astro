---
interface Props {
  obstacleRootId: string;
  swimStartId: string;
  footerId: string;
}

const { obstacleRootId, swimStartId, footerId } = Astro.props;
---

<fish-scene
  class="fish-scene"
  aria-hidden="true"
  data-fish-scene-obstacle-root={obstacleRootId}
  data-fish-scene-swim-start={swimStartId}
  data-fish-scene-footer={footerId}
>
  <canvas class="fish-scene__canvas" data-fish-scene-canvas></canvas>
</fish-scene>

<style lang="scss">
  @use "tools" as *;

  /* The element itself takes no space: it anchors the canvas across lower content and the footer. */
  .fish-scene {
    position: relative;
    display: block;
    height: 0;
  }

  .fish-scene__canvas {
    position: absolute;
    inset-block-start: rem(-200);
    inset-inline-start: 0;
    /* Above the footer and the lower part of the preceding content. */
    z-index: 1;
    display: block;
    width: 100%;
    /* Replaced with the measured footer band once the script runs. */
    height: rem(348);
    opacity: 0;
    pointer-events: none;
  }

  .fish-scene[data-fish-scene-ready] .fish-scene__canvas {
    opacity: 1;
  }
</style>

<script>
  import { defineFishScene } from '../../lib/fish-scene';

  defineFishScene();
</script>
