---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="hero">
  <div>
    <h1 class="hero-title">{title}</h1>
  </div>
  <div>
    <p class="text-body">{description}</p>
  </div>
  <slot />
</section>

<style lang="scss">
  @use "tools" as *;

  .hero-title {
    margin: 0;
  }
</style>