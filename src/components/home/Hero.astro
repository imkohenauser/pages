---
import ArchScene from './ArchScene.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__title font-display">{title}</h1>
    <div class="hero__description">
      <p class="hero__description-text">{description}</p>
    </div>
    <div class="hero__frame">
      <ArchScene />
    </div>
  </div>
</section>

<style lang="scss">
  @use "tools" as *;

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      "title title title title"
      "desc desc frame frame";
    align-items: start;
    gap: var(--space-2);
    padding-inline: var(--space-3);

    @include md {
      grid-template-areas:
        "title title frame frame"
        "desc desc frame frame";
      gap: var(--space-4);
      padding-inline: var(--space-4);
    }
  }

  .hero__title {
    grid-area: title;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    padding-right: max(var(--space-8), 8vw);
    font-size: var(--text-2xl);
    line-height: rem(32);
    letter-spacing: -0.015em;
    text-wrap: balance;

    @include md {
      font-size: var(--text-3xl);
      line-height: rem(40);
      text-align: center;
    }
  }

  .hero__description {
    grid-area: desc;
    padding: var(--space-4) var(--space-3);

    @include md {
      text-align: center;
    }
  }

  /* Body copy: 14/24 on small screens, 16/24 from md. */
  .hero__description-text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: rem(24);
    text-wrap: balance;

    @include md {
      font-size: var(--text-md);
    }
  }

  .hero__frame {
    grid-area: frame;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;

    @include md {
      height: rem(400);
      max-height: rem(400);
      padding-top: var(--space-8);
    }
  }
</style>
