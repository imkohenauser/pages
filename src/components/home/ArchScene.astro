---
import { path } from '../../lib/path';

interface Props {
  avatarSrc?: string;
}

const { avatarSrc = path('/avatar.svg') } = Astro.props;
---

<arch-scene class="arch-scene">
  <div class="arch-scene__outer" aria-hidden="true"></div>
  <div class="arch-scene__floor" aria-hidden="true"></div>
  <button
    class="arch-scene__inner"
    type="button"
    aria-label="白馬のアニメーションを再生"
    data-arch-scene-trigger
  >
    <img class="arch-scene__avatar" src={avatarSrc} alt="" width="1000" height="1000" />
  </button>
  <canvas class="arch-scene__canvas" aria-hidden="true" data-arch-scene-canvas></canvas>
</arch-scene>

<style lang="scss">
  @use "tools" as *;

  .arch-scene {
    position: relative;
    isolation: isolate;
    display: block;
    /* The gate is a 1:2 portrait, so it fits the available width on small screens. */
    width: 100%;
    aspect-ratio: 1 / 2;

    @include md {
      /* Fit the available height instead, letting the ratio derive the width. */
      width: auto;
      height: 100%;
    }
  }

  .arch-scene__outer {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* A horizontal radius of half the width with a matching vertical radius makes the top a semicircle. */
    border-radius: 50% 50% 0 0 / 25% 25% 0 0;
    background-image: linear-gradient(to top, var(--neutral-50) 75%, var(--neutral-300) 100%);
    /* Layered shadow so the gate reads as standing on the page. */
    box-shadow:
      0 rem(3) rem(5) rgb(0 0 0 / 0.1),
      0 rem(9) rem(9) rgb(0 0 0 / 0.09),
      0 rem(19) rem(12) rgb(0 0 0 / 0.05);
  }

  /* Triangle rising from the bottom edge to the middle of the gate. Only the part left uncovered by
     the inner arch shows, which reads as the floor receding into the gate. */
  .arch-scene__floor {
    position: absolute;
    inset: 50% 0 0;
    z-index: 1;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    background-image: linear-gradient(to left, var(--neutral-50), var(--neutral-300) 25%);
  }

  .arch-scene__inner {
    position: absolute;
    /* Frame thickness: 6% of the width at the sides, 4% above the arch and 6% below. */
    inset: 4% 6% 6%;
    /* 220 / 900 of the inner box, keeping this arch a semicircle as well. */
    border-radius: 50% 50% 0 0 / 24.444% 24.444% 0 0;
    overflow: hidden;
    z-index: 1;
    padding: 0;
    appearance: none;
    cursor: pointer;
    background: transparent;
    border: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(3);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  .arch-scene__avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .arch-scene__canvas {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .arch-scene[data-arch-scene-ready] .arch-scene__canvas {
    opacity: 1;
  }
</style>

<script>
  import { defineArchScene } from '../../lib/arch-scene';

  defineArchScene();
</script>
