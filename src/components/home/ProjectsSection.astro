---
import type { Project } from '../../lib/projects';
import { projectListItem } from '../../lib/list';
import List from '../List.astro';
import Section from '../Section.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<Section title="Projects" titleId="projects-title">
  <List
    variant="projects"
    headingLevel={3}
    items={projects.map(projectListItem)}
  />
</Section>
