---
import { writingListItem } from '../../lib/list';
import List from '../List.astro';
import type { Writing } from '../../lib/writing';

interface Props {
  writing: Writing[];
}

const { writing } = Astro.props;
---

<section aria-labelledby="writing-title">
  <h2 id="writing-title">Writing</h2>
  <List
    variant="writing"
    headingLevel={3}
    items={writing.map(writingListItem)}
  />
</section>
