---
import { writingListItem } from '../../lib/list';
import { path } from '../../lib/path';
import List from '../List.astro';
import Section from '../Section.astro';
import ButtonLink from '../ButtonLink.astro';
import type { Writing } from '../../lib/writing';

interface Props {
  writing: Writing[];
  hasMore: boolean;
}

const { writing, hasMore } = Astro.props;
---

<Section title="Writing" titleId="writing-title">
  <List
    variant="writing"
    headingLevel={3}
    items={writing.map(writingListItem)}
  />
  {
    hasMore && (
      <ButtonLink
        slot="footer"
        href={path('/writing/')}
        ariaLabel="View all writing"
      >
        View all
      </ButtonLink>
    )
  }
</Section>
