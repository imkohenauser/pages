---
import { site } from '../data/site';
import { path } from '../lib/path';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={path('/')}>{site.name}</a>
    <nav class="site-header__nav" aria-label="External links">
      <ul class="site-header__links">
        {site.externalLinks.map((link) => (
          <li class="site-header__item">
            <a
              class="site-header__link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                class="site-header__icon"
                src={path(link.icon)}
                alt=""
                width="24"
                height="24"
              />
              <span class="site-header__label">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__links {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 48rem) {
    .site-header__label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }
</style>
