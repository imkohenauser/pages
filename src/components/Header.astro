---
import { site } from '../data/site';
import { path } from '../lib/path';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div>
    <a href={path('/')}>{site.name}</a>
    <nav aria-label="External links">
      <ul class="site-header__links">
        {site.externalLinks.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={link.icon} class="site-header__icon" />
              <span class="site-header__label">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use "tools" as *;

  .site-header__links {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header :global(.site-header__icon) {
    flex-shrink: 0;
    width: rem(24);
    height: rem(24);
  }

  .site-header__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;

    @include md {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }
</style>
