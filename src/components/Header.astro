---
import { site } from '../data/site';
import { path } from '../lib/path';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__name" href={path('/')}>
      {site.name}<span class="hidden-mobile"> {site.kanaName}</span>
    </a>
    <nav class="site-header__nav" aria-label="External links">
      <ul class="site-header__links">
        {site.externalLinks.map((link) => (
          <li>
            <a
              class="site-header__link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={link.icon} class="site-header__icon" />
              <span class="site-header__label">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use "tools" as *;

  .site-header {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 1;

    @include ml {
      position: relative;
      flex-shrink: 0;
      width: rem(200);
      padding: var(--space-20) 0;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: rem(64);
    padding: var(--space-3) var(--space-4);

    @include ml {
      flex-direction: column;
      gap: var(--space-16);
      align-items: flex-start;
      justify-content: flex-start;
      min-height: rem(44);
      padding: var(--space-4) var(--space-4) var(--space-2);
    }
  }

  .site-header__name {
    padding: var(--space-2);
    font-size: var(--text-sm);
    line-height: rem(24);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-2);

    @include ml {
      width: 90%;
      text-wrap: balance;
      white-space: normal;
    }
  }

  .site-header__links {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0 rem(2);
    list-style: none;

    @include ml {
      flex-direction: column;
    }
  }

  .site-header__link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: rem(11);
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-2);

    &:focus-visible {
      color: var(--sky-700);
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(2);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }

    @include hover {
      &:hover {
        color: var(--sky-700);
      }
    }

    @include hover-fine {
      @include motion-safe {
        &:hover :global(.site-header__icon),
        &:hover .site-header__label {
          animation: site-header-link-blink var(--motion-electronic-cycle)
            steps(1, jump-end) both;
        }
      }
    }

    @include ml {
      justify-content: flex-start;
      gap: var(--space-2);
      padding: var(--space-1\.5);
    }
  }

  .site-header :global(.site-header__icon) {
    flex-shrink: 0;
    width: rem(18);
    height: rem(18);
  }

  .site-header__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;

    @include ml {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      font-size: var(--text-xs);
      line-height: rem(20);
      white-space: nowrap;
    }
  }

  @keyframes site-header-link-blink {
    0%,
    100% {
      opacity: 1;
    }

    12% {
      opacity: 0.68;
    }

    30% {
      opacity: 1;
    }

    48% {
      opacity: 0.82;
    }
  }
</style>
