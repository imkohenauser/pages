---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox={icon.viewBox}
  width="16"
  height="16"
  aria-hidden="true"
>
  {
    icon.evenodd ? (
      <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={icon.d} />
    ) : (
      <path fill="currentColor" d={icon.d} />
    )
  }
</svg>

<style lang="scss">
  @use "functions" as *;

  .icon {
    display: block;
    width: rem(16);
    height: rem(16);
  }
</style>
