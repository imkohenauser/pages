const icon = icons[name];
---

<svg
  class:list={['icon', className]}
  viewBox={icon.viewBox}
  width="16"
  height="16"
  aria-hidden="true"
>
  {
    'stroke' in icon ? (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap={'linecap' in icon ? icon.linecap : undefined}
        stroke-linejoin={'linejoin' in icon ? icon.linejoin : undefined}
        d={icon.d}
      />
    ) : icon.evenodd ? (
      <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={icon.d} />
    ) : (
      <path fill="currentColor" d={icon.d} />
    )
  }
</svg>

<style lang="scss">
  @use "tools" as *;

  .icon {
    display: block;
    width: rem(16);
    height: rem(16);
  }
</style>
