---
import Icon from './Icon.astro';

interface Props {
  href: string;
  ariaLabel?: string;
}

const { href, ariaLabel } = Astro.props;
---

<button-link-interaction>
  <a class="button-link" href={href} aria-label={ariaLabel}>
    <span class="button-link__label"><slot>View all</slot></span>
    <span class="button-link__icon">
      <Icon name="arrow-right" />
    </span>
  </a>
</button-link-interaction>

<style lang="scss">
  @use "tools" as *;

  button-link-interaction {
    display: inline-flex;
  }

  .button-link {
    --button-link-inner-edge:
      inset 0 0 0 #{rem(1)} rgb(255 255 255 / 34%),
      inset 0 #{rem(-1)} 0 rgb(8 47 107 / 18%);
    --button-link-outer-shadow:
      0 #{rem(1)} #{rem(2)} rgb(0 0 0 / 12%),
      0 #{rem(5)} #{rem(10)} #{rem(-3)} rgb(0 0 0 / 10%),
      0 #{rem(12)} #{rem(24)} #{rem(-8)} rgb(0 0 0 / 8%);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: rem(138);
    min-height: rem(42);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-5);
    overflow: hidden;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: rem(24);
    color: var(--color-text-inverse);
    text-decoration: none;
    text-shadow:
      0 rem(1) rem(1) rgb(0 0 0 / 9%),
      0 rem(2) rem(1) rgb(0 0 0 / 5%);
    user-select: none;
    touch-action: manipulation;
    background: linear-gradient(
      180deg,
      var(--sky-900) 0%,
      var(--sky-800) 15%,
      var(--sky-700) 30%,
      var(--sky-500) 60%,
      var(--sky-400) 75%,
      var(--sky-200) 100%
    );
    background-position: center top;
    background-size: 100% 125%;
    border-radius: var(--radius-4);
    box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    -webkit-tap-highlight-color: transparent;

    &::before {
      position: absolute;
      pointer-events: none;
      content: "";
      z-index: 0;
      inset: rem(-1) rem(-1) auto;
      height: rem(20);
      background: linear-gradient(
        180deg,
        rgb(255 255 255 / 80%),
        rgb(255 255 255 / 20%)
      );
      border-radius: rem(20);
    }

    &:focus-visible {
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(3);
    }

    @include hover-fine {
      &:hover {
        --button-link-outer-shadow:
          0 #{rem(2)} #{rem(4)} #{rem(-1)} rgb(0 0 0 / 10%),
          0 #{rem(8)} #{rem(16)} #{rem(-4)} rgb(0 0 0 / 9%),
          0 #{rem(18)} #{rem(32)} #{rem(-10)} rgb(0 0 0 / 7%);

        // @include motion-safe {
        //   transform: translateY(rem(-1));
        // }
      }
    }

    @include motion-safe {
      transition:
        filter 50ms ease-out,
        transform 80ms ease-out,
        box-shadow 180ms ease-out;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link {
    @include motion-safe {
      animation: button-link-blinky 266.667ms steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link::before {
    @include motion-safe {
      animation: button-link-gloss-blinky 266.667ms steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-pressed] .button-link {
    background: linear-gradient(
      180deg,
      var(--sky-950) 0%,
      var(--sky-900) 22%,
      var(--sky-800) 45%,
      var(--sky-700) 70%,
      var(--sky-500) 100%
    );
    box-shadow:
      var(--button-link-inner-edge),
      0 rem(1) rem(1) rgb(0 0 0 / 10%),
      0 rem(2) rem(1) rgb(0 0 0 / 8%);

    @include motion-safe {
      transform: translateY(rem(1)) scale(0.97);
      transition-duration: 50ms;
    }
  }

  button-link-interaction[data-button-link-afterglow] .button-link {
    box-shadow:
      var(--button-link-inner-edge),
      var(--button-link-outer-shadow),
      inset 0 0 0 rem(1) rgb(255 255 255 / 55%),
      inset 0 0 rem(9) rgb(255 255 255 / 34%);

    @include motion-safe {
      animation: button-link-afterglow 300ms ease-out;
    }
  }

  .button-link__label,
  .button-link__icon {
    position: relative;
    z-index: 1;

    @include motion-safe {
      transition: opacity 80ms ease-out;
    }
  }

  button-link-interaction[data-button-link-pressed] .button-link__label,
  button-link-interaction[data-button-link-pressed] .button-link__icon {
    opacity: 0.92;
  }

  button-link-interaction[data-button-link-blinking] .button-link__label {
    @include motion-safe {
      animation: button-link-label-blinky 266.667ms steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link__icon {
    @include motion-safe {
      animation: button-link-icon-blinky 266.667ms steps(1, jump-end) forwards;
    }
  }

  .button-link__label {
    white-space: nowrap;
  }

  .button-link__icon {
    display: grid;
    flex-shrink: 0;
    width: rem(16);
    height: rem(16);
    filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
  }

  @keyframes button-link-blinky {
    0%,
    100% {
      background: linear-gradient(
        180deg,
        var(--sky-900) 0%,
        var(--sky-800) 15%,
        var(--sky-700) 30%,
        var(--sky-500) 60%,
        var(--sky-400) 75%,
        var(--sky-200) 100%
      );
      box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    }

    25% {
      background: linear-gradient(
        180deg,
        var(--sky-950) 0%,
        var(--sky-900) 22%,
        var(--sky-800) 45%,
        var(--sky-700) 70%,
        var(--sky-500) 100%
      );
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 rem(8) rgb(8 47 107 / 28%);
    }

    50% {
      background: linear-gradient(
        180deg,
        var(--sky-700) 0%,
        var(--sky-600) 20%,
        var(--sky-500) 42%,
        var(--sky-400) 67%,
        var(--sky-300) 83%,
        var(--sky-100) 100%
      );
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) rgb(255 255 255 / 58%),
        inset 0 0 rem(10) rgb(255 255 255 / 36%);
    }

    75% {
      background: linear-gradient(
        180deg,
        var(--sky-900) 0%,
        var(--sky-800) 25%,
        var(--sky-700) 50%,
        var(--sky-600) 75%,
        var(--sky-400) 100%
      );
      box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    }
  }

  @keyframes button-link-gloss-blinky {
    0%,
    100% {
      opacity: 1;
    }

    25% {
      opacity: 0.46;
    }

    50% {
      opacity: 1;
    }

    75% {
      opacity: 0.68;
    }
  }

  @keyframes button-link-label-blinky {
    0%,
    100% {
      opacity: 1;
      text-shadow:
        0 rem(1) rem(1) rgb(0 0 0 / 9%),
        0 rem(2) rem(1) rgb(0 0 0 / 5%);
    }

    25% {
      opacity: 0.9;
      text-shadow: 0 rem(1) rem(1) rgb(0 0 0 / 14%);
    }

    50% {
      opacity: 1;
      text-shadow:
        0 0 rem(5) rgb(255 255 255 / 82%),
        0 rem(1) rem(1) rgb(0 0 0 / 7%);
    }

    75% {
      opacity: 0.94;
      text-shadow: 0 rem(1) rem(1) rgb(0 0 0 / 11%);
    }
  }

  @keyframes button-link-icon-blinky {
    0%,
    100% {
      opacity: 1;
      filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
    }

    25% {
      opacity: 0.9;
      filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 14%));
    }

    50% {
      opacity: 1;
      filter:
        drop-shadow(0 0 rem(4) rgb(255 255 255 / 90%))
        drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
    }

    75% {
      opacity: 0.94;
      filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 11%));
    }
  }

  @keyframes button-link-afterglow {
    0% {
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) rgb(255 255 255 / 65%),
        inset 0 0 rem(11) rgb(255 255 255 / 42%);
    }

    100% {
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) transparent,
        inset 0 0 rem(9) transparent;
    }
  }
</style>

<script>
  class ButtonLinkInteraction extends HTMLElement {
    private abortController?: AbortController;
    private blinkTimer?: number;
    private blinkResetTimer?: number;
    private afterglowTimer?: number;
    private blinkReady = true;

    connectedCallback() {
      if (this.abortController) return;

      const link = this.querySelector('a');
      if (!(link instanceof HTMLAnchorElement)) return;

      this.abortController = new AbortController();
      const { signal } = this.abortController;

      link.addEventListener('pointerenter', this.handlePointerEnter, { signal });
      link.addEventListener('pointerleave', this.handlePointerLeave, { signal });
      link.addEventListener('pointerdown', this.handlePointerDown, { signal });
      link.addEventListener('pointerup', this.handlePointerUp, { signal });
      link.addEventListener('pointercancel', this.handlePointerCancel, { signal });
      link.addEventListener('keydown', this.handleKeyDown, { signal });
      link.addEventListener('keyup', this.handleKeyUp, { signal });
      link.addEventListener('blur', this.handleBlur, { signal });
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = undefined;
      this.clearTimers();
    }

    private handlePointerEnter = () => {
      window.clearTimeout(this.blinkResetTimer);

      if (
        !this.blinkReady ||
        !window.matchMedia('(hover: hover) and (pointer: fine)').matches ||
        !window.matchMedia('(prefers-reduced-motion: no-preference)').matches
      ) {
        return;
      }

      this.blinkReady = false;
      this.toggleAttribute('data-button-link-blinking', true);
      window.clearTimeout(this.blinkTimer);
      this.blinkTimer = window.setTimeout(() => {
        this.removeAttribute('data-button-link-blinking');
      }, 267);
    };

    private handlePointerLeave = () => {
      window.clearTimeout(this.blinkResetTimer);
      this.blinkResetTimer = window.setTimeout(() => {
        this.blinkReady = true;
      }, 400);
      this.finishPress(false);
    };

    private handlePointerDown = (event: PointerEvent) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      window.clearTimeout(this.blinkTimer);
      this.removeAttribute('data-button-link-blinking');
      this.removeAttribute('data-button-link-afterglow');
      this.toggleAttribute('data-button-link-pressed', true);
    };

    private handlePointerUp = () => {
      this.finishPress(true);
    };

    private handlePointerCancel = () => {
      this.finishPress(false);
    };

    private handleKeyDown = (event: KeyboardEvent) => {
      if (event.key !== 'Enter' || event.repeat) return;
      this.removeAttribute('data-button-link-afterglow');
      this.toggleAttribute('data-button-link-pressed', true);
    };

    private handleKeyUp = (event: KeyboardEvent) => {
      if (event.key !== 'Enter') return;
      this.finishPress(true);
    };

    private handleBlur = () => {
      this.finishPress(false);
    };

    private finishPress(showAfterglow: boolean) {
      if (!this.hasAttribute('data-button-link-pressed')) return;

      this.removeAttribute('data-button-link-pressed');
      if (!showAfterglow) return;

      this.toggleAttribute('data-button-link-afterglow', true);
      window.clearTimeout(this.afterglowTimer);
      this.afterglowTimer = window.setTimeout(() => {
        this.removeAttribute('data-button-link-afterglow');
      }, 300);
    }

    private clearTimers() {
      window.clearTimeout(this.blinkTimer);
      window.clearTimeout(this.blinkResetTimer);
      window.clearTimeout(this.afterglowTimer);
    }
  }

  if (!customElements.get('button-link-interaction')) {
    customElements.define('button-link-interaction', ButtonLinkInteraction);
  }
</script>
