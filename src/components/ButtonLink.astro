---
import Icon from './Icon.astro';

interface Props {
  href: string;
  ariaLabel?: string;
}

const { href, ariaLabel } = Astro.props;
---

<button-link-interaction>
  <a class="button-link" href={href} aria-label={ariaLabel}>
    <span class="button-link__label"><slot>View all</slot></span>
    <span class="button-link__icon">
      <Icon name="arrow-right" />
    </span>
  </a>
</button-link-interaction>

<style lang="scss">
  @use "tools" as *;

  $surface-stable: linear-gradient(
    180deg,
    var(--sky-900) 0%,
    var(--sky-800) 15%,
    var(--sky-700) 30%,
    var(--sky-500) 60%,
    var(--sky-400) 75%,
    var(--sky-200) 100%
  );
  $surface-dim: linear-gradient(
    180deg,
    var(--sky-950) 0%,
    var(--sky-900) 22%,
    var(--sky-800) 45%,
    var(--sky-700) 70%,
    var(--sky-500) 100%
  );
  $surface-weak: linear-gradient(
    180deg,
    var(--sky-900) 0%,
    var(--sky-800) 25%,
    var(--sky-700) 50%,
    var(--sky-600) 75%,
    var(--sky-400) 100%
  );
  $surface-bloom: linear-gradient(
    180deg,
    var(--sky-700) 0%,
    var(--sky-600) 20%,
    var(--sky-500) 42%,
    var(--sky-400) 67%,
    var(--sky-300) 83%,
    var(--sky-100) 100%
  );
  $label-shadow-stable:
    0 rem(1) rem(1) rgb(0 0 0 / 9%),
    0 rem(2) rem(1) rgb(0 0 0 / 5%);

  button-link-interaction {
    display: inline-flex;
  }

  .button-link {
    --button-link-inner-edge:
      inset 0 #{rem(1)} 0 rgb(255 255 255 / 20%),
      inset 0 #{rem(-1)} 0 color-mix(in srgb, var(--sky-950) 32%, transparent);
    --button-link-outer-shadow:
      0 #{rem(1)} #{rem(2)} rgb(0 0 0 / 16%),
      0 #{rem(5)} #{rem(9)} #{rem(-4)} rgb(0 0 0 / 14%);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: rem(138);
    min-height: rem(42);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-5);
    overflow: hidden;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: rem(24);
    color: var(--color-text-inverse);
    text-decoration: none;
    text-shadow: $label-shadow-stable;
    user-select: none;
    touch-action: manipulation;
    background: $surface-stable;
    background-position: center top;
    background-size: 100% 125%;
    border-radius: var(--radius-4);
    box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    -webkit-tap-highlight-color: transparent;

    &::before {
      position: absolute;
      pointer-events: none;
      content: "";
      z-index: 0;
      inset: rem(-1) rem(-1) auto;
      height: rem(20);
      background: linear-gradient(
        180deg,
        rgb(255 255 255 / 80%),
        rgb(255 255 255 / 20%)
      );
      border-radius: rem(20);
    }

    &:focus-visible {
      outline: rem(3) solid var(--color-focus);
      outline-offset: rem(3);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }

    @include hover-fine {
      &:hover {
        --button-link-outer-shadow:
          0 #{rem(2)} #{rem(3)} #{rem(-1)} rgb(0 0 0 / 14%),
          0 #{rem(7)} #{rem(12)} #{rem(-5)} rgb(0 0 0 / 13%);
      }
    }

    @include motion-safe {
      transition:
        transform var(--motion-material-release) ease-out,
        box-shadow 180ms ease-out;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link {
    @include motion-safe {
      animation: button-link-blinky var(--motion-electronic-cycle)
        steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link::before {
    @include motion-safe {
      animation: button-link-gloss-blinky var(--motion-electronic-cycle)
        steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-pressed] .button-link {
    background: $surface-dim;
    box-shadow:
      inset 0 0 0 rem(1) rgb(255 255 255 / 14%),
      inset 0 rem(2) rem(2) rgb(255 255 255 / 16%),
      inset 0 rem(-3) rem(4) color-mix(in srgb, var(--sky-950) 42%, transparent);

    @include motion-safe {
      transform: translateY(rem(1)) scale(0.97);
      /* The press is the deliberate half, so it runs slower than the release. */
      transition:
        transform var(--motion-material-press) ease-out,
        box-shadow var(--motion-material-press) ease-out;
    }
  }

  /* The afterglow exists only as motion, so reduced motion drops it rather than flashing it. */
  button-link-interaction[data-button-link-afterglow] .button-link {
    @include motion-safe {
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) rgb(255 255 255 / 55%),
        inset 0 0 rem(9) rgb(255 255 255 / 34%);
      animation: button-link-afterglow var(--motion-material-afterglow) ease-out;
    }
  }

  .button-link__label,
  .button-link__icon {
    position: relative;
    z-index: 1;

    @include motion-safe {
      transition: opacity var(--motion-material-release) ease-out;
    }
  }

  button-link-interaction[data-button-link-pressed] .button-link__label,
  button-link-interaction[data-button-link-pressed] .button-link__icon {
    opacity: 0.92;
  }

  button-link-interaction[data-button-link-blinking] .button-link__label {
    @include motion-safe {
      animation: button-link-label-blinky var(--motion-electronic-cycle)
        steps(1, jump-end) forwards;
    }
  }

  button-link-interaction[data-button-link-blinking] .button-link__icon {
    @include motion-safe {
      animation: button-link-icon-blinky var(--motion-electronic-cycle)
        steps(1, jump-end) forwards;
    }
  }

  .button-link__label {
    white-space: nowrap;
  }

  .button-link__icon {
    display: grid;
    flex-shrink: 0;
    width: rem(16);
    height: rem(16);
    filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
  }

  // A fixed irregular cadence reads as a designed fault rather than random noise.
  @keyframes button-link-blinky {
    0%,
    78%,
    100% {
      background: $surface-stable;
      box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    }

    9%,
    31% {
      background: $surface-dim;
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 rem(8) color-mix(in srgb, var(--sky-950) 28%, transparent);
    }

    20% {
      background: $surface-weak;
      box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    }

    47% {
      background: $surface-bloom;
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) rgb(255 255 255 / 58%),
        inset 0 0 rem(10) rgb(255 255 255 / 36%);
    }

    63% {
      background: $surface-weak;
      box-shadow: var(--button-link-inner-edge), var(--button-link-outer-shadow);
    }
  }

  @keyframes button-link-gloss-blinky {
    0%,
    82%,
    100% {
      opacity: 1;
    }

    13%,
    35% {
      opacity: 0.38;
    }

    24% {
      opacity: 0.76;
    }

    51% {
      opacity: 1;
    }

    67% {
      opacity: 0.68;
    }
  }

  @keyframes button-link-label-blinky {
    0%,
    29%,
    59%,
    100% {
      opacity: 1;
      text-shadow: $label-shadow-stable;
    }

    35% {
      opacity: 0.86;
      text-shadow: 0 rem(1) rem(1) rgb(0 0 0 / 14%);
    }

    43% {
      opacity: 1;
      text-shadow: $label-shadow-stable;
    }

    51% {
      opacity: 1;
      text-shadow:
        0 0 rem(5) rgb(255 255 255 / 82%),
        0 rem(1) rem(1) rgb(0 0 0 / 7%);
    }
  }

  @keyframes button-link-icon-blinky {
    0%,
    38%,
    67%,
    100% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
    }

    47% {
      opacity: 0.9;
      transform: translateX(rem(-1));
      filter: drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 14%));
    }

    55% {
      opacity: 1;
      transform: translateX(rem(1));
      filter:
        drop-shadow(0 0 rem(4) rgb(255 255 255 / 90%))
        drop-shadow(#{rem(-2)} 0 rem(1) rgb(255 255 255 / 58%))
        drop-shadow(#{rem(-4)} 0 rem(2) color-mix(in srgb, var(--sky-200) 32%, transparent))
        drop-shadow(0 rem(1) rem(0.5) rgb(0 0 0 / 9%));
    }
  }

  @keyframes button-link-afterglow {
    0% {
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) rgb(255 255 255 / 65%),
        inset 0 0 rem(11) rgb(255 255 255 / 42%);
    }

    100% {
      box-shadow:
        var(--button-link-inner-edge),
        var(--button-link-outer-shadow),
        inset 0 0 0 rem(1) transparent,
        inset 0 0 rem(9) transparent;
    }
  }
</style>

<script>
  import { defineButtonLinkInteraction } from '../lib/button-link';

  defineButtonLinkInteraction();
</script>
