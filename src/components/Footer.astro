---
import { site } from '../data/site';
import { path } from '../lib/path';
import ActionLink from './ActionLink.astro';
---

<footer id="site-footer" class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <small class="site-footer__copyright">
        © {new Date().getFullYear()} {site.shortName}.
      </small>
      <a class="site-footer__llms" href={path('/llms.txt')}>llms.txt</a>
    </div>
    <page-top-link>
      <a
        href="#top"
        class="site-footer__page-top"
        aria-label="Page top"
      >
        <ActionLink variant="page-top" decorative />
      </a>
    </page-top-link>
  </div>
</footer>

<style lang="scss">
  @use "tools" as *;

  .site-footer {
    /* Keep the footer's blend group above the fish canvas that extends across this region. */
    position: relative;
    z-index: 2;
    mix-blend-mode: multiply;
    padding-block: var(--space-20) var(--space-10);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-4);
  }

  .site-footer__meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding-inline: var(--space-2);
    white-space: nowrap;
  }

  .site-footer__copyright {
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text-muted);
  }

  .site-footer__llms {
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: rem(2);

    @include hover-color-transition;

    @include hover {
      &:hover {
        color: var(--color-link);
      }
    }

    &:focus-visible {
      color: var(--color-link);
      outline: rem(3) solid var(--color-focus);
      outline-offset: rem(2);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  page-top-link {
    display: inline-flex;
    flex-shrink: 0;
  }

  .site-footer__page-top {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-2);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
      --action-link-label: var(--color-link);
      --action-link-icon: var(--color-link);

      outline: rem(3) solid var(--color-focus);
      outline-offset: rem(2);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }

    @include hover {
      &:hover {
        --action-link-label: var(--color-link);
        --action-link-icon: var(--color-link);
      }
    }

    @include hover-fine {
      @include motion-safe {
        &:hover :global(.action-link__label),
        &:hover :global(.action-link__icon) {
          animation: page-top-link-blink var(--motion-electronic-cycle)
            steps(1, jump-end) both;
        }
      }
    }

    @include motion-safe {
      transition: transform var(--motion-material-release) ease-out;
    }
  }

  @keyframes page-top-link-blink {
    0%,
    100% {
      opacity: 1;
    }

    12% {
      opacity: 0.68;
    }

    30% {
      opacity: 1;
    }

    48% {
      opacity: 0.82;
    }
  }

  page-top-link[data-page-top-pressed] .site-footer__page-top {

    @include motion-safe {
      transform: translateY(rem(1)) scale(0.97);
      transition-duration: var(--motion-material-press);
    }
  }
</style>

<script>
  import { definePageTopLink } from '../lib/page-top';

  definePageTopLink();
</script>
