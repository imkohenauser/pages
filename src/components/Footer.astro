---
import { site } from '../data/site';
import ActionLink from './ActionLink.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <small class="site-footer__copyright">© {new Date().getFullYear()} {site.shortName}.</small>
    <page-top-link>
      <a href="#top" class="site-footer__page-top" aria-label="Page top">
        <ActionLink variant="page-top" decorative />
      </a>
    </page-top-link>
  </div>
</footer>

<style lang="scss">
  @use "tools" as *;

  .site-footer {
    mix-blend-mode: multiply;
    padding-block: var(--space-30) var(--space-20);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-4);
  }

  .site-footer__copyright {
    padding-inline: var(--space-2);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  page-top-link {
    display: inline-flex;
    flex-shrink: 0;
  }

  .site-footer__page-top {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
      --action-link-label: var(--sky-700);
      --action-link-icon: var(--sky-600);

      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(2);
    }

    @include hover {
      &:hover {
        --action-link-label: var(--sky-800);
        --action-link-icon: var(--sky-600);
      }
    }

    @include hover-fine {
      @include motion-safe {
        &:hover :global(.action-link__label),
        &:hover :global(.action-link__icon) {
          animation: page-top-link-blink var(--motion-electronic-cycle)
            steps(1, jump-end) both;
        }
      }
    }

    @include motion-safe {
      transition: transform var(--motion-material-release) ease-out;
    }
  }

  @keyframes page-top-link-blink {
    0%,
    100% {
      opacity: 1;
    }

    12% {
      opacity: 0.68;
    }

    30% {
      opacity: 1;
    }

    48% {
      opacity: 0.82;
    }
  }

//   page-top-link[data-page-top-pressed] .site-footer__page-top {
//     opacity: 0.92;
// 
//     @include motion-safe {
//       transform: translateY(rem(1)) scale(0.97);
//       transition-duration: var(--motion-material-press);
//     }
//   }
</style>

<script>
  import { definePageTopLink } from '../lib/page-top';

  definePageTopLink();
</script>
