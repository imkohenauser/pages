---
import { site } from '../data/site';
import ActionLink from './ActionLink.astro';
---

<footer>
  <small>© {new Date().getFullYear()} {site.shortName}.</small>
  <a href="#top" class="site-footer__page-top" aria-label="Page top">
    <ActionLink variant="page-top" decorative />
  </a>
</footer>

<style lang="scss">
  .site-footer__page-top {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }
</style>
