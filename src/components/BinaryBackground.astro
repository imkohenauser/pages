<binary-background class="binary-background">
  <div class="binary-background__surface" aria-hidden="true">
    <div class="binary-background__gradient"></div>
    <div class="binary-background__glyphs">
      <canvas
        class="binary-background__canvas"
        data-binary-background-canvas
      ></canvas>
    </div>
  </div>
  <slot />
</binary-background>

<style lang="scss">
  @use "tools" as *;

  .binary-background {
    display: flow-root;
    position: relative;
    isolation: isolate;
  }

  .binary-background__surface {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-16));
    inset-inline-start: auto;
    inset-inline-end: 0;
    z-index: -1;
    width: rem(240);
    height: rem(640);
    overflow: hidden;
    pointer-events: none;
    /* The outer radii include the 100px feather around Figma's 280x480 ellipse. */
    mask-image: radial-gradient(
      ellipse #{rem(240)} #{rem(340)} at calc(100% + #{rem(20)}) #{rem(272)},
      #000 0%,
      #000 58%,
      rgb(0 0 0 / 80%) 68%,
      rgb(0 0 0 / 45%) 82%,
      rgb(0 0 0 / 15%) 93%,
      transparent 100%
    );
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-image: radial-gradient(
      ellipse #{rem(240)} #{rem(340)} at calc(100% + #{rem(20)}) #{rem(272)},
      #000 0%,
      #000 58%,
      rgb(0 0 0 / 80%) 68%,
      rgb(0 0 0 / 45%) 82%,
      rgb(0 0 0 / 15%) 93%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;

    @include md {
      inset-inline: 0;
      width: auto;
      height: rem(240);
      mask-image: none;
      -webkit-mask-image: none;
    }

    @include ml {
      /* The desktop sidebar shifts main content away from the viewport edge. */
      inset-inline-start: calc(
        -1 * (#{rem(244)} + max((100vw - #{rem(1024)}) / 2, 0px))
      );
      inset-inline-end: auto;
      width: 100vw;
    }
  }

  .binary-background__gradient {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    background: radial-gradient(
      ellipse #{rem(240)} #{rem(480)} at calc(100% + #{rem(24)}) #{rem(360)},
      color-mix(in srgb, var(--sky-700) 90%, var(--neutral-50)) 0%,
      color-mix(in srgb, var(--sky-500) 70%, var(--neutral-50)) 40%,
      color-mix(in srgb, var(--sky-300) 30%, var(--neutral-50)) 62%,
      var(--neutral-50) 82%
    );

    @include md {
      background: linear-gradient(
        180deg in oklab,
        color-mix(in srgb, var(--sky-700) 90%, var(--neutral-50)) 0%,
        color-mix(in srgb, var(--sky-500) 40%, var(--neutral-50)) 22%,
        color-mix(in srgb, var(--sky-300) 30%, var(--neutral-50)) 33%,
        var(--neutral-50) 50%
      );
    }
  }

  .binary-background__glyphs {
    position: absolute;
    inset-block: rem(-10);
    inset-inline-end: rem(-8);
    width: calc(64% + #{rem(16)});
    pointer-events: none;

    @include md {
      inset-inline-start: rem(-8);
      width: calc(100% + #{rem(16)});
    }
  }

  .binary-background__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .binary-background[data-binary-background-ready]
    .binary-background__canvas {
    opacity: 1;
  }
</style>

<script>
  import { defineBinaryBackground } from '../lib/binary-background';

  defineBinaryBackground();
</script>
