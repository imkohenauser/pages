<binary-background class="binary-background">
  <div class="binary-background__surface" aria-hidden="true">
    <div class="binary-background__gradient"></div>
    <div class="binary-background__glyphs">
      <canvas
        class="binary-background__canvas"
        data-binary-background-canvas
      ></canvas>
    </div>
  </div>
  <slot />
</binary-background>

<style lang="scss">
  @use "tools" as *;

  .binary-background {
    display: flow-root;
    position: relative;
    isolation: isolate;
  }

  .binary-background__surface {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-16));
    inset-inline: 0;
    z-index: -1;
    height: auto;
    aspect-ratio: 1 / 2;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 50%,
      transparent 100%
    );
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 50%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;

    @include md {
      height: rem(240);
      aspect-ratio: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }

    @include ml {
      /* The desktop sidebar shifts main content away from the viewport edge. */
      inset-inline-start: calc(
        -1 * (#{rem(244)} + max((100vw - #{rem(1024)}) / 2, 0px))
      );
      inset-inline-end: auto;
      width: 100vw;
    }
  }

  .binary-background__gradient {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 64%;
    background: linear-gradient(
      90deg,
      rgb(250 250 250 / 0%) 30%,
      var(--sky-400) 90%,
      var(--sky-500) 100%
    );

    @include md {
      inset-inline-start: 0;
      width: 100%;
      background: linear-gradient(
        180deg,
        var(--sky-500) 0%,
        var(--sky-400) 10%,
        rgb(250 250 250 / 0%) 70%
      );
    }
  }

  .binary-background__glyphs {
    position: absolute;
    inset-block: rem(-10);
    inset-inline-end: rem(-8);
    width: calc(64% + #{rem(16)});
    pointer-events: none;

    @include md {
      inset-inline-start: rem(-8);
      width: calc(100% + #{rem(16)});
    }
  }

  .binary-background__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .binary-background[data-binary-background-ready]
    .binary-background__canvas {
    opacity: 1;
  }
</style>

<script>
  import { defineBinaryBackground } from '../lib/binary-background';

  defineBinaryBackground();
</script>
