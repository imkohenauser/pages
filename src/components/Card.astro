---
import { Image } from 'astro:assets';
import ActionLink from './ActionLink.astro';
import { formatIsoDate } from '../lib/date';
import type { ListItem } from '../lib/list';

interface Props extends ListItem {
  variant: 'writing' | 'projects';
  headingLevel: 2 | 3;
}

const {
  variant,
  title,
  description,
  publishedAt,
  href,
  external,
  actionLinkVariant,
  actionLinkIconSrc,
  ariaLabel,
  featuredImage,
  featuredImageAlt,
  headingLevel,
  lang,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const isWriting = variant === 'writing';
const hasMeta = publishedAt || actionLinkVariant;
---

<article
  lang={lang}
  class:list={[
    'card',
    isWriting ? 'card--writing' : 'card--project',
    !featuredImage && 'card--no-thumbnail',
  ]}
>
  <div class="card__container">
    {
      featuredImage && (
        <div class="card__media">
          <div class="card__image-container">
            <Image
              src={featuredImage}
              alt={featuredImageAlt ?? ''}
              class="card__image"
            />
          </div>
        </div>
      )
    }
    <div class="card__body">
      <div class="card__text">
        <Heading class="card__title">
          {
            href ? (
              <a
                class="card__title-link"
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                aria-label={ariaLabel}
              >
                {title}
              </a>
            ) : (
              title
            )
          }
        </Heading>
        {description && <p class="card__description">{description}</p>}
      </div>
      {
        hasMeta && (
          <div class="card__meta">
            {publishedAt && (
              <time class="card__date" datetime={publishedAt.toISOString()}>
                {formatIsoDate(publishedAt)}
              </time>
            )}
            {actionLinkVariant && (
              <ActionLink
                variant={actionLinkVariant}
                iconSrc={actionLinkIconSrc}
                decorative
              />
            )}
          </div>
        )
      }
    </div>
  </div>
</article>

<style lang="scss">
  @use "tools" as *;

  .card {
    --card-edge-dim: inset 0 0 0 transparent;
    --card-edge-weak: inset 0 0 0 transparent;
    --card-edge-bloom: inset 0 0 0 transparent;

    position: relative;
    isolation: isolate;
    border-radius: var(--radius-4);

    &::after {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      content: "";
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px transparent;

      @include motion-safe {
        transition: box-shadow 160ms ease-out;
      }
    }

    &:has(.card__title-link:focus-visible) {
      background: white;
      box-shadow: var(--card-shadow-hover);
    }

    &:has(.card__title-link:focus-visible)::after {
      box-shadow:
        inset 0 0 0 1px var(--card-title),
        var(--card-edge-dim);
    }

    @include hover {
      &:has(.card__title-link):hover {
        background: white;
        box-shadow: var(--card-shadow-hover);
      }

      &:has(.card__title-link):hover::after {
        box-shadow:
          inset 0 0 0 1px var(--card-title),
          var(--card-edge-dim);
      }
    }

    @include motion-safe {
      transition: box-shadow 180ms ease-out;
    }

    @include hover-fine {
      @include motion-safe {
        &:has(.card__title-link):hover {
          animation: card-surface-blinky 480ms steps(1, jump-end) forwards;
        }

        &:has(.card__title-link):hover::after {
          animation: card-edge-blinky 480ms steps(1, jump-end) forwards;
        }
      }
    }
  }

  .card--writing,
  .card--project {
    --card-title: var(--color-text);
    --card-muted: var(--color-text-muted);
    --card-surface-rest: linear-gradient(
      90deg,
      var(--neutral-50) 0%,
      var(--neutral-100) 100%
    );
    --card-surface-dim: linear-gradient(
      90deg,
      var(--neutral-100) 0%,
      var(--neutral-200) 100%
    );
    --card-surface-weak: linear-gradient(
      90deg,
      white 0%,
      var(--neutral-50) 100%
    );
    --card-shadow-hover: 0 #{rem(7)} #{rem(16)} #{rem(-10)} rgb(38 38 38 / 18%);
    --card-edge-dim:
      inset 0 0 #{rem(5)} color-mix(in srgb, var(--sky-700) 26%, transparent);
    --card-edge-weak:
      inset 0 0 0 1px color-mix(in srgb, var(--sky-600) 54%, transparent),
      inset 0 0 #{rem(11)} color-mix(in srgb, var(--sky-500) 42%, transparent);
    --card-edge-bloom:
      inset 0 0 0 #{rem(2)} color-mix(in srgb, var(--sky-600) 92%, transparent),
      inset 0 0 #{rem(8)} color-mix(in srgb, var(--sky-500) 72%, transparent),
      inset 0 0 #{rem(22)} color-mix(in srgb, var(--sky-400) 46%, transparent);

    box-shadow: 0 0 0 1px var(--color-border);
    background: var(--card-surface-rest);
  }

  .card--project {
    --card-surface-rest: linear-gradient(
      90deg,
      var(--sky-50) 0%,
      var(--sky-100) 100%
    );
    --card-surface-dim: linear-gradient(
      90deg,
      var(--sky-100) 0%,
      var(--sky-200) 100%
    );
    --card-surface-weak: linear-gradient(
      90deg,
      white 0%,
      var(--sky-50) 100%
    );
  }

  .card__title-link {
    color: inherit;
    text-decoration: none;

    &:focus-visible {
      outline: none;
    }

    &::after {
      position: absolute;
      inset: 0;
      z-index: 3;
      border-radius: var(--radius-4);
      content: "";
    }

    &:focus-visible::after {
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(3);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  .card__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .card--project .card__container {
    @include md {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      align-items: stretch;
      padding: 0 0 0 rem(10);
    }
  }

  .card--no-thumbnail .card__container {
    @include md {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card__media {
    min-width: 0;
    padding: var(--space-2) var(--space-2) 0;

    @include md {
      padding: var(--space-2) 0;
    }
  }

  .card__image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .card--project .card__image-container {
    @include md {
      /* A definite height plus aspect-ratio inflates min-content width past the 3fr track. */
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }

  .card__image {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-2);
    object-fit: cover;
    object-position: center;
    outline: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    outline-offset: -1px;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-2) 0;

    @include md {
      padding: var(--space-3) 0;
    }
  }

  .card--project .card__body {
    gap: var(--space-2);
    padding: var(--space-2) 0;

    @include md {
      gap: var(--space-1);
      padding: var(--space-3) 0 var(--space-3) var(--space-1);
    }
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: rem(24);
    color: var(--card-title);

    @include md {
      font-size: var(--text-lg);
      line-height: rem(28);
    }
  }

  .card__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: rem(20);
    color: var(--card-muted);
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--space-1) var(--space-3);
  }

  .card__date {
    margin-inline-end: auto;
    padding: 0 var(--space-1\.5);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--card-muted);
  }

  /* Small luminance steps suggest ignition without a dark-to-light full-face flash. */
  @keyframes card-surface-blinky {
    0%,
    68% {
      background: var(--card-surface-rest);
    }

    8%,
    26% {
      background: var(--card-surface-dim);
    }

    17%,
    52% {
      background: var(--card-surface-weak);
    }

    36%,
    100% {
      background: white;
    }
  }

  @keyframes card-edge-blinky {
    0% {
      box-shadow: inset 0 0 0 1px var(--card-title);
    }

    8%,
    26%,
    68%,
    100% {
      box-shadow:
        inset 0 0 0 1px var(--card-title),
        var(--card-edge-dim);
    }

    17%,
    52% {
      box-shadow:
        inset 0 0 0 1px var(--card-title),
        var(--card-edge-weak);
    }

    36% {
      box-shadow:
        inset 0 0 0 1px var(--card-title),
        var(--card-edge-bloom);
    }
  }
</style>
