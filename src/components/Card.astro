---
import { Image } from 'astro:assets';
import ActionLink from './ActionLink.astro';
import { formatIsoDate } from '../lib/date';
import type { ListItem } from '../lib/list';

interface Props extends ListItem {
  variant: 'writing' | 'projects';
  headingLevel: 2 | 3;
}

const {
  variant,
  title,
  description,
  publishedAt,
  href,
  external,
  actionLinkVariant,
  actionLinkIconSrc,
  ariaLabel,
  featuredImage,
  featuredImageAlt,
  headingLevel,
  lang,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const isWriting = variant === 'writing';
const hasMeta = publishedAt || actionLinkVariant;
---

<article
  lang={lang}
  class:list={[
    'card',
    isWriting ? 'card--writing' : 'card--project',
    !featuredImage && 'card--no-thumbnail',
  ]}
>
  <div class="card__container">
    {
      featuredImage && (
        <div class="card__media">
          <div class="card__image-container">
            <Image
              src={featuredImage}
              alt={featuredImageAlt ?? ''}
              class="card__image"
            />
          </div>
        </div>
      )
    }
    <div class="card__body">
      <div class="card__text">
        <Heading class="card__title">
          {
            href ? (
              <a
                class="card__title-link"
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                aria-label={ariaLabel}
              >
                {title}
              </a>
            ) : (
              title
            )
          }
        </Heading>
        {description && <p class="card__description">{description}</p>}
      </div>
      {
        hasMeta && (
          <div class="card__meta">
            {publishedAt && (
              <time class="card__date" datetime={publishedAt.toISOString()}>
                {formatIsoDate(publishedAt)}
              </time>
            )}
            {actionLinkVariant && (
              <ActionLink
                variant={actionLinkVariant}
                iconSrc={actionLinkIconSrc}
                tone={isWriting ? 'default' : 'inverse'}
                decorative
              />
            )}
          </div>
        )
      }
    </div>
  </div>
</article>

<style lang="scss">
  @use "tools" as *;

  .card {
    position: relative;
    border-radius: var(--radius-4);
  }

  .card--writing {
    --card-title: var(--color-text);
    --card-muted: var(--color-text-muted);

    box-shadow: 0 0 0 1px var(--color-border);
    background: linear-gradient(
      90deg,
      var(--neutral-50) 0%,
      var(--neutral-100) 100%
    );
  }

  .card--project {
    --card-title: var(--color-text-inverse);
    --card-muted: var(--color-text-inverse-muted);

    box-shadow: 0 0 0 1px var(--color-inverse-raised);
    background: linear-gradient(
      90deg,
      var(--color-inverse-raised) 0%,
      var(--color-inverse) 100%
    );
  }

  .card__title-link {
    color: inherit;
    text-decoration: none;

    &::after {
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--radius-4);
      content: "";
    }
  }

  .card__container {
    display: flex;
    flex-direction: column;
  }

  .card--project .card__container {
    @include md {
      display: grid;
      grid-template-columns: 3fr 5fr;
      align-items: stretch;
      padding: 0 0 0 rem(10);
    }
  }

  .card--no-thumbnail .card__container {
    @include md {
      grid-template-columns: 1fr;
    }
  }

  .card__media {
    padding: var(--space-2) var(--space-2) 0;

    @include md {
      padding: var(--space-2) 0;
    }
  }

  .card__image-container {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
  }

  .card__image {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-2);
    object-fit: cover;
    object-position: center;
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-1);
    padding: var(--space-2) 0;

    @include md {
      padding: var(--space-3) 0;
    }
  }

  .card--project .card__body {
    gap: var(--space-2);
    padding: var(--space-2) 0;

    @include md {
      gap: var(--space-1);
      padding: var(--space-3) 0 var(--space-3) var(--space-1);
    }
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: rem(24);
    color: var(--card-title);

    @include md {
      font-size: var(--text-lg);
      line-height: rem(28);
    }
  }

  .card__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: rem(20);
    color: var(--card-muted);
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--space-1) var(--space-3);
  }

  .card__date {
    margin-inline-end: auto;
    padding: 0 var(--space-1\.5);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--card-muted);
  }
</style>
