---
import { Image } from 'astro:assets';
import ActionLink from './ActionLink.astro';
import { formatIsoDate } from '../lib/date';
import type { ListItem } from '../lib/list';

interface Props extends ListItem {
  variant: 'writing' | 'projects';
  headingLevel: 2 | 3;
}

const {
  variant,
  title,
  description,
  publishedAt,
  href,
  external,
  actionLinkVariant,
  actionLinkIconSrc,
  ariaLabel,
  featuredImage,
  featuredImageAlt,
  headingLevel,
  lang,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const isWriting = variant === 'writing';
const hasMeta = publishedAt || actionLinkVariant;
---

<card-interaction>
  <article
    lang={lang}
    class:list={[
      'card',
      isWriting ? 'card--writing' : 'card--project',
      !featuredImage && 'card--no-thumbnail',
    ]}
  >
    <div class="card__container">
      {
        featuredImage && (
          <div class="card__media">
            <div class="card__image-container">
              <Image
                src={featuredImage}
                alt={featuredImageAlt ?? ''}
                class="card__image"
              />
            </div>
          </div>
        )
      }
      <div class="card__body">
        <div class="card__text">
          <Heading class="card__title">
            {
              href ? (
                <a
                  class="card__title-link"
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  aria-label={ariaLabel}
                >
                  {title}
                </a>
              ) : (
                title
              )
            }
          </Heading>
          {description && <p class="card__description">{description}</p>}
        </div>
        {
          hasMeta && (
            <div class="card__meta">
              {publishedAt && (
                <time class="card__date" datetime={publishedAt.toISOString()}>
                  {formatIsoDate(publishedAt)}
                </time>
              )}
              {actionLinkVariant && (
                <ActionLink
                  variant={actionLinkVariant}
                  iconSrc={actionLinkIconSrc}
                  decorative
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </article>
</card-interaction>

<style lang="scss">
  @use "tools" as *;

  /* Short dwell so a cursor sweeping down a list never ignites the cards it passes. */
  $ignite-dwell: 40ms;

  @mixin card-lit {
    box-shadow:
      inset 0 0 0 1px var(--color-text-muted),
      0 0 0 1px transparent,
      var(--card-shadow-hover);

    &::before {
      opacity: 1;
    }
  }

  card-interaction {
    display: block;
  }

  .card {
    --card-edge-bloom: inset 0 0 0 transparent;

    position: relative;
    isolation: isolate;
    border-radius: var(--radius-4);

    /* Both layers sit inside the 1px ring so the ring stays legible at the bloom peak. */
    &::before,
    &::after {
      position: absolute;
      inset: rem(1);
      z-index: 0;
      pointer-events: none;
      content: "";
      border-radius: calc(var(--radius-4) - #{rem(1)});
      opacity: 0;
    }

    /* The lit surface is the only layer that holds a value at rest, so only it transitions. */
    &::before {
      background: white;

      @include motion-safe {
        transition: opacity 160ms ease-out;
      }
    }

    /* The bloom belongs to the ignition alone and leaves nothing behind. */
    &::after {
      box-shadow: var(--card-edge-bloom);
    }

    &:has(.card__title-link:focus-visible) {
      @include card-lit;
    }

    @include hover {
      &:has(.card__title-link):hover {
        @include card-lit;
      }
    }

    @include motion-safe {
      transition:
        transform var(--motion-material-release) ease-out,
        box-shadow var(--motion-hover-settle) ease-out;
    }

    @include hover-fine {
      @include motion-safe {
        &:has(.card__title-link):hover::before {
          animation: card-surface-ignite var(--motion-electronic-cycle)
            steps(1, jump-end) $ignite-dwell both;
        }

        &:has(.card__title-link):hover::after {
          animation: card-edge-ignite var(--motion-electronic-cycle)
            steps(1, jump-end) $ignite-dwell both;
        }

        &:has(.card__title-link):hover :global(.action-link__icon) {
          animation: card-action-link-ignite var(--motion-electronic-cycle)
            steps(1, jump-end) $ignite-dwell both;
        }
      }
    }
  }

  .card--writing,
  .card--project {
    --card-title: var(--color-text);
    --card-muted: var(--color-text-muted);
    --card-shadow-hover: 0 #{rem(7)} #{rem(16)} #{rem(-10)} rgb(38 38 38 / 18%);
    /*
     * The hard band stays hairline and the brightness comes from the diffuse halo,
     * so the peak reads as light rather than as a drawn blue border.
     */
    --card-edge-bloom:
      inset 0 0 0 1px color-mix(in srgb, var(--sky-500) 46%, transparent),
      inset 0 0 #{rem(12)} color-mix(in srgb, var(--sky-500) 42%, transparent),
      inset 0 0 #{rem(28)} color-mix(in srgb, var(--sky-400) 30%, transparent);

    background: var(--card-surface-rest);
  }

  .card--writing {
    --card-surface-rest: linear-gradient(
      90deg,
      var(--color-canvas) 0%,
      var(--color-surface) 100%
    );

    /* The transparent inset keeps the rest and lit shadow lists interpolable. */
    box-shadow:
      inset 0 0 0 1px transparent,
      0 0 0 1px var(--color-border);
  }

  .card--project {
    --card-surface-rest: linear-gradient(
      90deg,
      var(--sky-50) 0%,
      var(--sky-100) 100%
    );

    box-shadow:
      inset 0 0 0 1px transparent,
      0 0 0 1px var(--sky-200);
  }

  card-interaction[data-card-pressed] .card {
    box-shadow:
      inset 0 0 0 1px transparent,
      0 0 0 1px var(--color-border),
      inset 0 rem(2) rem(4) rgb(38 38 38 / 12%);

    @include motion-safe {
      transform: translateY(rem(1)) scale(0.97);
      /* The press is the deliberate half, so it runs slower than the release. */
      transition:
        transform var(--motion-material-press) ease-out,
        box-shadow var(--motion-material-press) ease-out;
    }
  }

  card-interaction[data-card-pressed] .card:has(.card__title-link:focus-visible) {
    box-shadow:
      inset 0 0 0 1px var(--card-title),
      0 0 0 1px transparent,
      inset 0 rem(2) rem(4) rgb(38 38 38 / 12%);
  }

  card-interaction[data-card-pressed] .card:has(.card__title-link):hover {
    @include hover {
      box-shadow:
        inset 0 0 0 1px var(--card-title),
        0 0 0 1px transparent,
        inset 0 rem(2) rem(4) rgb(38 38 38 / 12%);
    }
  }

  .card__title-link {
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
      outline: none;
    }

    &::after {
      position: absolute;
      inset: 0;
      z-index: 3;
      border-radius: var(--radius-4);
      content: "";
    }

    &:focus-visible::after {
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(3);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  .card__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .card--project .card__container {
    @include md {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      align-items: stretch;
      padding: 0 0 0 rem(10);
    }
  }

  .card--no-thumbnail .card__container {
    @include md {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card__media {
    min-width: 0;
    padding: var(--space-2) var(--space-2) 0;

    @include md {
      padding: var(--space-2) 0;
    }
  }

  .card__image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .card--project .card__image-container {
    @include md {
      /* A definite height plus aspect-ratio inflates min-content width past the 3fr track. */
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }

  .card__image {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-2);
    object-fit: cover;
    object-position: center;
    outline: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    outline-offset: -1px;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-2) 0;

    @include md {
      padding: var(--space-3) 0;
    }
  }

  .card--project .card__body {
    gap: var(--space-2);
    padding: var(--space-2) 0;

    @include md {
      gap: var(--space-1);
      padding: var(--space-3) 0 var(--space-3) var(--space-1);
    }
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: rem(24);
    color: var(--card-title);

    @include md {
      font-size: var(--text-lg);
      line-height: rem(28);
    }
  }

  .card__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: rem(20);
    color: var(--card-muted);
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--space-1) var(--space-3);
  }

  .card__date {
    margin-inline-end: auto;
    padding: 0 var(--space-1\.5);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--card-muted);
  }

  /*
   * Ignition in temporal order: a struck spark, a near stall, full bloom, one dip,
   * then the resting state. The 0% stop is what the dwell delay holds, so it must
   * match the unlit card.
   */
  @keyframes card-surface-ignite {
    0% {
      opacity: 0;
    }

    4% {
      opacity: 0.45;
    }

    20% {
      opacity: 0.08;
    }

    42% {
      opacity: 1;
    }

    64% {
      opacity: 0.35;
    }

    100% {
      opacity: 1;
    }
  }

  @keyframes card-edge-ignite {
    0% {
      opacity: 0;
    }

    4% {
      opacity: 0.22;
    }

    20% {
      opacity: 0.06;
    }

    42% {
      opacity: 1;
    }

    64% {
      opacity: 0.2;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes card-action-link-ignite {
    0%,
    20%,
    42%,
    64%,
    100% {
      opacity: 1;
    }

    4% {
      opacity: 0.72;
    }
  }
</style>

<script>
  import { defineCardInteraction } from '../lib/card';

  defineCardInteraction();
</script>
