---
import type { WritingLabel } from '../lib/writing-label';

interface Props {
  options: { label: WritingLabel; count: number }[];
}

const { options } = Astro.props;
---

<search>
  <label for="writing-query">Search writing</label>
  <input
    id="writing-query"
    type="search"
    name="writing-query"
    autocomplete="off"
  />
</search>
<fieldset>
  <legend>Filter by label</legend>
  <ul>
    {
      options.map(({ label, count }) => (
        <li>
          <label>
            <input type="checkbox" name="writing-label" value={label} />
            <span translate="no">{label}</span> ({count})
          </label>
        </li>
      ))
    }
  </ul>
</fieldset>
