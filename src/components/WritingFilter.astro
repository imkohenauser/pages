---
import type { WritingLabel } from '../lib/writing-label';
import Icon from './Icon.astro';

interface Props {
  options: { label: WritingLabel; count: number }[];
}

const { options } = Astro.props;
---

<div class="writing-filter">
  <fieldset class="writing-filter__labels">
    <legend class="visually-hidden">Filter by label</legend>
    <ul class="writing-filter__label-list">
      {
        options.map(({ label, count }) => (
          <li class="writing-filter__label-item">
            <label class="writing-filter__chip" data-writing-filter-chip>
              <input
                class="visually-hidden"
                type="checkbox"
                name="writing-label"
                value={label}
              />
              <span class="writing-filter__chip-label" translate="no">
                {label}
              </span>
              <span class="writing-filter__count">{count}</span>
            </label>
          </li>
        ))
      }
    </ul>
  </fieldset>
  <search class="writing-filter__search">
    <label class="visually-hidden" for="writing-query">Search</label>
    <div
      class="writing-filter__search-field"
      data-writing-filter-field
    >
      <span class="writing-filter__search-icon" aria-hidden="true">
        <Icon name="search" />
      </span>
      <input
        class="writing-filter__search-input"
        id="writing-query"
        type="search"
        name="writing-query"
        autocomplete="off"
        data-writing-filter-query
      />
      <button
        class="writing-filter__clear"
        type="button"
        data-writing-filter-clear
        hidden
        aria-label="Clear search"
      >
        <Icon name="circle-x-fill" />
      </button>
    </div>
  </search>
</div>

<style lang="scss">
  @use "tools" as *;

  @mixin writing-filter-focus-ring {
    outline: rem(3) solid var(--sky-400);
    outline-offset: rem(2);

    @media (forced-colors: active) {
      outline: rem(2) solid CanvasText;
    }
  }

  .writing-filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);

    @include md {
      flex-direction: row;
      align-items: center;
    }
  }

  .writing-filter__labels,
  .writing-filter__search {
    margin-inline: calc(-1 * var(--space-2));

    @include md {
      margin-inline: 0;
    }
  }

  .writing-filter__labels {
    flex: 1 1 0;
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .writing-filter__label-list {
    display: flex;
    gap: var(--space-2);
    margin-block: rem(-5);
    padding-block: rem(5);
    padding-inline: var(--space-4);
    overflow-x: auto;
    list-style: none;
    scroll-padding-inline: var(--space-4);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .writing-filter__label-item {
    flex-shrink: 0;
  }

  .writing-filter__chip {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding-block: var(--space-1\.5);
    padding-inline: var(--space-4) var(--space-3);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text);
    cursor: pointer;
    background: var(--neutral-100);
    border: rem(2) solid var(--neutral-100);
    border-radius: 9999px;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:has(input:checked) {
      background: var(--neutral-50);
      border-color: var(--sky-700);
    }

    &:has(input:focus-visible) {
      @include writing-filter-focus-ring;
    }

    @include motion-safe {
      transition: transform var(--motion-material-release) ease-out;
    }

    @include hover {
      &:hover .writing-filter__chip-label {
        color: var(--sky-700);
      }
    }

    @include hover-fine {
      @include motion-safe {
        &:hover .writing-filter__chip-label {
          animation: writing-filter-chip-label-blink var(--motion-electronic-cycle)
            steps(1, jump-end) both;
        }
      }
    }
  }

  .writing-filter__chip[data-writing-filter-chip-pressed] {
    @include motion-safe {
      transform: translateY(rem(1)) scale(0.97);
      transition-duration: var(--motion-material-press);
    }
  }

  .writing-filter__chip-label {
    text-transform: capitalize;

    @include hover-color-transition;
  }

  .writing-filter__count {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: rem(20);
    padding-inline: var(--space-1\.5);
    overflow: hidden;
    font-size: rem(10);
    font-weight: 700;
    line-height: rem(20);
    color: var(--color-text-inverse);
    text-overflow: ellipsis;
    white-space: nowrap;
    background: var(--neutral-600);
    border-radius: 9999px;
  }

  .writing-filter__search {
    flex: 1 1 0;
    min-width: 0;
    padding-inline: var(--space-4);
  }

  .writing-filter__search-field {
    display: flex;
    align-items: center;
    min-width: 0;
    height: rem(32);
    padding-inline: var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;

    &:has(:focus-visible) {
      @include writing-filter-focus-ring;
    }
  }

  .writing-filter__search-icon {
    flex-shrink: 0;
    width: rem(16);
    margin-inline-end: var(--space-2);
    overflow: hidden;
    color: var(--color-text);

    @include motion-safe {
      transition:
        opacity var(--motion-hover-settle) ease-out,
        width var(--motion-hover-settle) ease-out,
        margin-inline-end var(--motion-hover-settle) ease-out;
    }
  }

  .writing-filter__search-field:is(:focus-within, [data-writing-filter-filled])
    .writing-filter__search-icon {
    width: 0;
    margin-inline-end: 0;
    opacity: 0;
  }

  .writing-filter__search-input,
  .writing-filter__clear {
    &:focus-visible {
      outline: none;
    }
  }

  .writing-filter__search-input {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    padding: 0;
    font: inherit;
    /* iOS Safari zooms focused inputs below 16px. */
    font-size: var(--text-md);
    line-height: rem(20);
    color: var(--color-text);
    appearance: none;
    background: transparent;
    border: 0;

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .writing-filter__clear {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: rem(24);
    height: rem(24);
    margin-inline-start: var(--space-2);
    padding: 0;
    color: var(--neutral-600);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: 9999px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &:not([hidden]) {
      display: flex;
    }
  }

  @keyframes writing-filter-chip-label-blink {
    0%,
    100% {
      opacity: 1;
    }

    12% {
      opacity: 0.68;
    }

    30% {
      opacity: 1;
    }

    48% {
      opacity: 0.82;
    }
  }
</style>
