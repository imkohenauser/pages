---
import SourceMark from './SourceMark.astro';
import { itemSource, type ListItem } from '../lib/list';

interface Props {
  items: ListItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const format = new Intl.DateTimeFormat('ja-JP');
---

<ol class={className}>
  {items.map((item) => {
    const source = itemSource(item);

    return (
      <li>
        {item.publishedAt && (
          <time datetime={item.publishedAt.toISOString()}>
            {format.format(item.publishedAt)}
          </time>
        )}
        <h3>
          {item.href ? (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.title}
              {source && (
                <>
                  <span class="source" aria-hidden="true">
                    <SourceMark source={source.id} />
                    <span translate="no">{source.label}</span>
                    ↗
                  </span>
                  <span class="visually-hidden">
                    ({source.label}, opens in a new tab)
                  </span>
                </>
              )}
            </a>
          ) : (
            item.title
          )}
        </h3>
        {item.description && <p>{item.description}</p>}
        {item.links && item.links.length > 0 && (
          <ul class="links">
            {item.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <SourceMark source={link.source} icon={link.icon} />
                  <span translate="no">{link.label}</span>
                  <span aria-hidden="true">↗</span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ol>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  h3 {
    margin: 0;
  }

  .writing h3 {
    display: inline;
    font: inherit;
  }

  .source,
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 1.5rem;
  }

  a {
    position: relative;
  }

  .source {
    margin-inline-start: var(--space-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }
</style>
