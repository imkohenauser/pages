import Card from './Card.astro';
import type { ListItem } from '../lib/list';

interface Props {
  items: ListItem[];
  class?: string;
  variant: 'writing' | 'projects';
  headingLevel: 2 | 3;
}

const { items, class: className, variant, headingLevel } = Astro.props;
---

<ol class:list={['content-list', className]}>
  {
    items.map((item) => (
      <li
        class="content-list__item"
        data-writing-label={item.label}
      >
        <Card {...item} variant={variant} headingLevel={headingLevel} />
      </li>
    ))
  }
</ol>

<style lang="scss">
  .content-list {
    display: flex;
    flex-flow: column;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0;
    list-style: none;
  }

  .content-list__item {
    width: 100%;
  }
</style>
