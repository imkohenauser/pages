---
import type { WritingLabel } from '../lib/writing-label';

interface Props {
  options: { label: WritingLabel; count: number }[];
}

const { options } = Astro.props;
const legendId = 'writing-label-filter-legend';
---

<fieldset class="writing-label-filter" aria-labelledby={legendId}>
  <legend class="writing-label-filter__legend" id={legendId}>
    Filter by label
  </legend>
  <ul class="writing-label-filter__list">
    {
      options.map(({ label, count }) => (
        <li class="writing-label-filter__item">
          <label class="writing-label-filter__option">
            <input
              class="writing-label-filter__input"
              type="checkbox"
              name="writing-label"
              value={label}
            />
            <span class="writing-label-filter__text">
              <span class="writing-label-filter__name" translate="no">
                {label}
              </span>
              <span class="writing-label-filter__count">({count})</span>
            </span>
          </label>
        </li>
      ))
    }
  </ul>
</fieldset>

<style lang="scss">
  @use "tools" as *;

  .writing-label-filter {
    margin: 0;
    padding: var(--space-4) var(--space-4) 0;
    border: 0;
    min-inline-size: 0;
  }

  .writing-label-filter__legend {
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: rem(20);
    color: var(--color-text-muted);
  }

  .writing-label-filter__list {
    display: flex;
    flex-flow: column;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .writing-label-filter__option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }

  .writing-label-filter__input {
    flex-shrink: 0;
    width: rem(14);
    height: rem(14);
    margin: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: rem(3);
    appearance: none;
    background: var(--color-canvas);
    cursor: pointer;

    &:checked {
      border-color: var(--color-text);
      background-color: var(--color-text);
      box-shadow: inset 0 0 0 rem(2) var(--color-canvas);
    }

    &:focus-visible {
      outline: rem(3) solid var(--sky-400);
      outline-offset: rem(2);

      @media (forced-colors: active) {
        outline: rem(2) solid CanvasText;
      }
    }
  }

  .writing-label-filter__text {
    display: inline-flex;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: rem(20);
    color: var(--color-text);
  }

  .writing-label-filter__count {
    color: var(--color-text-muted);
  }
</style>
