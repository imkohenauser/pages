---
import { Font } from 'astro:assets';
import { SITE } from '@/consts';
import { absoluteUrl, withBase } from '@/lib/paths';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to the social preview image. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const socialImage = absoluteUrl(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={withBase('/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

{
  /*
  Deliberately no `preload`. `<Font preload />` emits a preload link for every
  file in the family, and the Japanese subset is ~120 unicode-range chunks per
  weight — that would fetch megabytes up front for glyphs the page may never
  render (withastro/astro#15841). The chunks are discovered from the stylesheet
  instead, and `font-display: swap` plus Astro's metric-matched fallback covers
  the gap.
*/
}
<Font cssVariable="--font-ibm-plex-sans-jp" />
<Font cssVariable="--font-ibm-plex-mono" />
