---
import type { ExternalSource } from '../lib/external-source';
import { markSrc, type MarkImage } from '../lib/list';

interface Props {
  source: ExternalSource;
  icon?: MarkImage;
}

const { source, icon } = Astro.props;
const customSrc = icon ? markSrc(icon) : undefined;
---

{customSrc ? (
  <img class="mark" src={customSrc} alt="" width="16" height="16" />
) : source === 'github' ? (
  <svg
    class="mark"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 4.51c.68.003 1.36.092 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
    />
  </svg>
) : source === 'medium' ? (
  <svg
    class="mark"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12m7.42 0c0 3.54-1.51 6.42-3.38 6.42s-3.39-2.88-3.39-6.42 1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12"
    />
  </svg>
) : source === 'zenn' ? (
  <svg
    class="mark"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M.264 23.771h4.984c.264 0 .498-.147.645-.377L19.614.874c.147-.23.147-.518 0-.746-.147-.23-.382-.377-.645-.377H13.99c-.264 0-.498.147-.645.377L.264 23.394zm7.37 0h4.984c.264 0 .498-.147.645-.377L23.736.874c.147-.23.147-.518 0-.746C23.589-.102 23.354-.25 23.09-.25h-4.984c-.264 0-.498.147-.645.377L7.634 23.394z"
    />
  </svg>
) : (
  <svg
    class="mark"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="8" cy="8" r="6.25" />
    <path d="M1.75 8h12.5M8 1.75c1.7 1.85 2.55 3.93 2.55 6.25S9.7 12.4 8 14.25C6.3 12.4 5.45 10.32 5.45 8S6.3 3.6 8 1.75Z" />
  </svg>
)}

<style>
  .mark {
    display: block;
    flex-shrink: 0;
    width: 1em;
    height: 1em;
  }

  img.mark {
    border-radius: 0.125rem;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }
</style>
